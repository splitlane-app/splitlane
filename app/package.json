    "demo:capture": "electron scripts/capture-screens.mjs"
  },
  "devDependencies": {
    "@dnd-kit/abstract": "0.5.3",
    "@dnd-kit/dom": "0.5.3",
    "@dnd-kit/helpers": "0.5.3",
    "@dnd-kit/react": "0.5.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "30.1.3",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zustand": "5.0.16"
  }
