# Одноразовая проверка осуществимости: ключ узла Tailscale, секрет API, настоящие адреса.
spike/

# Макеты из обсуждения дизайна.
.superpowers/

node_modules/

# Скачанное ядро (scripts/fetch-core.ps1).
/.cache/

# Данные режима разработки: состояние встроенного узла, журналы, конфиг ядра.
/.dev/

# Каталоги сборки.
/helper/bin/
/dist/
/app/out/
/app/dist/
/app/release/

# Windows version resource of the helper, made by scripts/build-helper.ps1 for the build only.
/helper/cmd/splitlane-helper/*.syso

# The demo window of the screenshots (app/vite.demo.config.ts) and the icons extracted for it from this PC.
/app/out-demo/
/app/src/renderer/demo/icons.local.json
